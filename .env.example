# Base de datos (Prisma / Supabase Postgres)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Redis (BullMQ — docker compose en docker/)
REDIS_URL=redis://127.0.0.1:6379

# Cifrado de secretos tenant (AES-256-GCM, 32 bytes en base64 o hex)
ENCRYPTION_KEY=your-32-byte-encryption-key

# JWT de sesión API
JWT_SECRET=your-jwt-secret-min-32-chars

# API core
PORT=3001
CORS_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001

# Dev bootstrap (scripts/bootstrap-dev.mjs)
DEV_SUPERADMIN_EMAIL=superadmin@uniwai.dev
DEV_SUPERADMIN_PASSWORD=SuperAdmin123!
