{
  "name": "@uniwai/database",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma schema and client for UniWai CRM (multi-tenant WhatsApp CRM)",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "db:generate": "bun --env-file=../../.env.local prisma generate",
    "db:push": "bun --env-file=../../.env.local prisma db push",
    "db:migrate": "bun --env-file=../../.env.local prisma migrate dev",
    "db:migrate:deploy": "bun --env-file=../../.env.local prisma migrate deploy",
    "db:seed": "bun --env-file=../../.env.local prisma db seed",
    "db:studio": "bun --env-file=../../.env.local prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.9.0"
  },
  "devDependencies": {
    "prisma": "^6.9.0",
    "typescript": "^5.8.3"
  },
  "prisma": {
    "seed": "bun run prisma/seed.ts"
  }
}
